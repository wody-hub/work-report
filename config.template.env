# work-report 설정
# setup 이 이 파일을 ~/.config/work-report/config.env 로 복사한다.
# 그 사본을 수정해서 쓴다 (저장소에는 커밋되지 않음).

# ── 필수 ────────────────────────────────────────────────────────────────
# 수집 대상 경로. 콜론(:) 으로 구분. 이 경로 하위에서 실행된 세션만 모은다.
# 각 경로의 마지막 폴더명이 리포트의 범위 라벨이 된다.
#   예) "$HOME/Projects/acme" → 라벨 acme, 표기 ~acme
WORK_TARGETS="$HOME/Projects/example:$HOME/Notes/example-vault"

# 결과를 둘 폴더.
# macOS 에서 ~/Documents 나 ~/Desktop 은 피하라 — iCloud 동기화 대상이라
# 대용량 폴더를 넣으면 ' 2' 충돌 폴더가 생기고 데이터가 클라우드로 나간다.
WORK_DIR="$HOME/work-report-out"

# ── 선택 ────────────────────────────────────────────────────────────────
# 시간대 오프셋 (시간 단위). 기본 9 = KST.
WORK_TZ_OFFSET="9"

# 지시문 길이 상한(자). 초과분은 잘라내고 "…(총 N자 중 앞부분)" 을 붙인다.
# 프롬프트에 붙여넣은 소스코드·계획서 전문이 결과물에 실려 나가는 것을 막는다.
# 0 = 무제한.
WORK_MAX_CHARS="10000"

# ── 코드 변경(diff) 수집 ────────────────────────────────────────────────
# 커밋의 실제 diff 를 날짜별 code.patch 로 모은다. 0 으로 끈다.
WORK_CODE="1"

# 파일 하나의 최대 diff 줄 수. 넘으면 잘린다.
WORK_CODE_MAX_FILE_LINES="500"

# 하루 patch 최대 크기(KB). 넘으면 이후 커밋을 생략한다.
WORK_CODE_MAX_DAY_KB="2048"

# 포함할 확장자 (콤마 구분). 비우면 기본 목록(소스·설정·문서).
WORK_CODE_EXT=""

# ── 자격증명 마스킹 ─────────────────────────────────────────────────────
# 값을 [REDACTED:…] 로 치환한다. 0 으로 끄면 원문 그대로 나간다.
WORK_MASK="1"

# IP 주소도 마스킹. 버전번호·좌표와 겹쳐 오탐이 많아 기본은 꺼둔다.
WORK_MASK_IP="0"

# 확실히 지울 문자열 목록 (한 줄에 하나). 파일이 없으면 무시한다.
# 주의: 이 파일 자체가 평문 비밀번호 목록이 된다.
WORK_MASK_FILE="$HOME/.config/work-report/secrets.txt"

# ── git 커밋 수집 ───────────────────────────────────────────────────────
# 내 이메일. 콜론 구분. 비우면 git config --global user.email 을 쓴다.
# 여러 이메일로 커밋한 이력이 있으면 전부 나열한다.
WORK_GIT_AUTHORS=""

# 이 날짜 이후 커밋만. 비우면 전체 이력 (AI 도구 사용 전 기간까지 포함된다).
WORK_GIT_SINCE=""

# 저장소 탐색 깊이.
WORK_GIT_DEPTH="4"

# 하위 경로를 바꾸고 싶을 때만 지정.
# EXPORT_DIR="$WORK_DIR/export"     수집 원본 (digest)
# BYDATE_DIR="$WORK_DIR/by-date"    업로드할 날짜별 결과
# LOG_DIR="$WORK_DIR/logs"
# STATE="$WORK_DIR/.last-upload.sha256"
