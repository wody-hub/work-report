# work-report 설정
# setup 이 이 파일을 ~/.config/work-report/config.env 로 복사한다.
# 그 사본을 수정해서 쓴다 (저장소에는 커밋되지 않음).

# ── 필수 ────────────────────────────────────────────────────────────────
# 수집 대상 경로. 콜론(:) 으로 구분. 이 경로 하위에서 실행된 세션만 모은다.
# 각 경로의 마지막 폴더명이 리포트의 범위 라벨이 된다.
#   예) "$HOME/Projects/acme" → 라벨 acme, 표기 ~acme
WORK_TARGETS="$HOME/Projects/example:$HOME/Notes/example-vault"

# 결과를 둘 폴더.
# macOS 에서 ~/Documents 나 ~/Desktop 은 피하라 — iCloud 동기화 대상이라
# 대용량 폴더를 넣으면 ' 2' 충돌 폴더가 생기고 데이터가 클라우드로 나간다.
WORK_DIR="$HOME/work-report-out"

# ── 선택 ────────────────────────────────────────────────────────────────
# 시간대 오프셋 (시간 단위). 기본 9 = KST.
WORK_TZ_OFFSET="9"

# 하위 경로를 바꾸고 싶을 때만 지정.
# EXPORT_DIR="$WORK_DIR/export"     수집 원본 (digest)
# BYDATE_DIR="$WORK_DIR/by-date"    업로드할 날짜별 결과
# LOG_DIR="$WORK_DIR/logs"
# STATE="$WORK_DIR/.last-upload.sha256"
