#!/usr/bin/env bash
# work-report setup — Claude Code 또는 Codex 에 스킬을 등록한다.
set -euo pipefail

INSTALL_DIR="$(cd "$(dirname "$0")" && pwd)"
SKILL_SRC="$INSTALL_DIR/skills/work-report"
CONFIG_DIR="$HOME/.config/work-report"
CONFIG="$CONFIG_DIR/config.env"
HOST=""

usage() {
  cat <<'EOF'
Usage: ./setup [--host claude|codex]

  --host claude   ~/.claude/skills 에 등록
  --host codex    ~/.codex/skills 에 등록

host 를 생략하면 설치된 것을 자동 감지한다. 둘 다 있으면 둘 다 등록한다.
EOF
}

while [ $# -gt 0 ]; do
  case "$1" in
    --host) [ $# -ge 2 ] || { echo "Error: --host 에 값이 필요합니다" >&2; exit 1; }
            HOST="$2"; shift 2 ;;
    --host=*) HOST="${1#*=}"; shift ;;
    -h|--help) usage; exit 0 ;;
    *) echo "Error: 알 수 없는 인자: $1" >&2; usage >&2; exit 1 ;;
  esac
done

[ -f "$SKILL_SRC/SKILL.md" ] || {
  echo "Error: $SKILL_SRC/SKILL.md 가 없습니다. 저장소 루트에서 실행하세요." >&2
  exit 1
}

# 등록할 host 결정
HOSTS=()
case "$HOST" in
  claude|codex) HOSTS=("$HOST") ;;
  "")
    [ -d "$HOME/.claude" ] && HOSTS+=("claude")
    [ -d "$HOME/.codex" ] && HOSTS+=("codex")
    [ ${#HOSTS[@]} -gt 0 ] || {
      echo "Error: ~/.claude 도 ~/.codex 도 없습니다. --host 로 지정하세요." >&2
      usage >&2; exit 1
    } ;;
  *) echo "Error: 지원하지 않는 host '$HOST'. claude 또는 codex." >&2; exit 1 ;;
esac

command -v python3 >/dev/null || {
  echo "Error: python3 가 필요합니다." >&2; exit 1; }

echo "work-report setup"
echo "  source: $INSTALL_DIR"
echo ""

for h in "${HOSTS[@]}"; do
  case "$h" in
    claude) SKILLS_DIR="$HOME/.claude/skills" ;;
    codex)  SKILLS_DIR="$HOME/.codex/skills" ;;
  esac
  mkdir -p "$SKILLS_DIR"
  target="$SKILLS_DIR/work-report"
  if [ -e "$target" ] && [ ! -L "$target" ]; then
    echo "  [$h] 건너뜀 — 심링크가 아닌 항목이 이미 있습니다: $target" >&2
    continue
  fi
  ln -snf "$SKILL_SRC" "$target"
  echo "  [$h] $target -> $SKILL_SRC"
done

chmod +x "$SKILL_SRC/scripts/run.sh"

# 설정 파일은 저장소 밖에 둔다 — 개인 경로가 커밋되지 않게
echo ""
mkdir -p "$CONFIG_DIR"
if [ -f "$CONFIG" ]; then
  echo "  설정: $CONFIG (이미 있음 — 그대로 둡니다)"
else
  cp "$INSTALL_DIR/config.template.env" "$CONFIG"
  echo "  설정: $CONFIG 생성"
  echo ""
  echo "  ⚠ 이 파일을 열어 WORK_TARGETS 와 WORK_DIR 를 채우세요."
fi

echo ""
echo "완료. 새 세션을 열고 /work-report 를 확인하세요."
